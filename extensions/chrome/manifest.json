{
  "manifest_version": 3,
  "name": "Folio PDF Viewer",
  "version": "0.6.0",
  "description": "Open PDFs in Folio's viewer in the browser, or hand off to the Folio desktop app.",
  "icons": { "128": "icons/icon-128.png" },
  "minimum_chrome_version": "128",
  "permissions": ["contextMenus", "declarativeNetRequest", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Open the current PDF in Folio (desktop)" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "web_accessible_resources": [{ "resources": ["dist/index.html"], "matches": ["<all_urls>"] }],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; frame-ancestors 'none'"
  }
}
