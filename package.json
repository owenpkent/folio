{
  "name": "folio",
  "version": "0.7.0",
  "description": "A world-class, open-source PDF viewer. Fast, accessible, extensible, dark-mode native.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/owenpkent/folio",
  "repository": {
    "type": "git",
    "url": "https://github.com/owenpkent/folio.git"
  },
  "bugs": {
    "url": "https://github.com/owenpkent/folio/issues"
  },
  "keywords": [
    "pdf",
    "pdf-viewer",
    "pdf.js",
    "tauri",
    "react",
    "accessibility",
    "annotations",
    "dark-mode"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/setup-ocr-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "prebuild": "node scripts/setup-ocr-assets.mjs",
    "preview": "vite preview",
    "setup:ocr": "node scripts/setup-ocr-assets.mjs",
    "tauri": "tauri",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check:versions": "node scripts/check-tauri-versions.mjs && node scripts/check-extension-version.mjs",
    "check:extension": "node scripts/check-extension-version.mjs && node scripts/check-extension-manifest.mjs",
    "build:chrome": "node extensions/chrome/build.mjs",
    "package:chrome": "node extensions/chrome/build.mjs --zip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:fuzz": "node scripts/run-fuzz.mjs",
    "test:e2e": "playwright test",
    "test:e2e:preview": "playwright test -c playwright.preview.config.ts",
    "release:manifest": "node scripts/generate-latest.mjs",
    "release:sbom": "node scripts/generate-sbom.mjs"
  },
  "dependencies": {
    "@peculiar/x509": "2.1.0",
    "@signpdf/placeholder-pdf-lib": "^3.3.0",
    "@signpdf/signpdf": "^3.3.0",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-deep-link": "^2.6.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "asn1js": "3.0.10",
    "buffer": "^6.0.3",
    "des.js": "1.1.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pkijs": "3.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reflect-metadata": "0.2.2",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fast-check/vitest": "^0.5.0",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
