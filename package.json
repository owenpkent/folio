{
  "name": "folio",
  "version": "0.5.0",
  "description": "A world-class, open-source PDF viewer. Fast, accessible, extensible, dark-mode native.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/owenpkent/folio",
  "repository": {
    "type": "git",
    "url": "https://github.com/owenpkent/folio.git"
  },
  "bugs": {
    "url": "https://github.com/owenpkent/folio/issues"
  },
  "keywords": [
    "pdf",
    "pdf-viewer",
    "pdf.js",
    "tauri",
    "react",
    "accessibility",
    "annotations",
    "dark-mode"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/setup-ocr-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "prebuild": "node scripts/setup-ocr-assets.mjs",
    "preview": "vite preview",
    "setup:ocr": "node scripts/setup-ocr-assets.mjs",
    "tauri": "tauri",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check:versions": "node scripts/check-tauri-versions.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:fuzz": "node scripts/run-fuzz.mjs",
    "test:e2e": "playwright test",
    "test:e2e:preview": "playwright test -c playwright.preview.config.ts",
    "release:manifest": "node scripts/generate-latest.mjs",
    "release:sbom": "node scripts/generate-sbom.mjs"
  },
  "dependencies": {
    "@signpdf/placeholder-pdf-lib": "^3.3.0",
    "@signpdf/signer-p12": "^3.3.0",
    "@signpdf/signpdf": "^3.3.0",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "buffer": "^6.0.3",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@fast-check/vitest": "^0.4.1",
    "@playwright/test": "^1.62.0",
    "@tauri-apps/cli": "^2.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "eslint": "^9.17.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fast-check": "^4.9.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
